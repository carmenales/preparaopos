   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">The Puerta del Sol square is the main public square in the city of Madrid, Spain. In the middle of the square is located the office of the President of the Community of Madrid.</rdf:li>
    </rdf:Alt>
   </dc:description>
