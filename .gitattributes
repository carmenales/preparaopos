# Normaliza finales de línea: LF en el repositorio y en la copia de trabajo,
# para que las herramientas de Windows que guardan con CRLF no generen diffs vacíos.
* text=auto eol=lf

# Scripts de Windows: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.npy binary
*.sqlite binary
